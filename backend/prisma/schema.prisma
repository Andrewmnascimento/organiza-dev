generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  free
  pro
}

enum BoardRole {
  owner
  member
}

enum IntegrationProvider {
  github
  gitlab
  jira
  trello
  asana
  linear
  notion
}

enum IntegrationStatus {
  active
  inactive
  expired
  error
}

model Columns {
  id          String   @id @default(cuid())
  name        String
  order       Int       @default(0)
  boardId     String
  board       Boards    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards       Cards[]   
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([id, boardId])
}

model Users {
  id          String   @id 
  plan        Plan     @default(free)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  boards      UserOnBoards[]
  comments    Comments[]
  integrations Integrations[]
  @@index([id])
}

model Boards {
  id            String   @id @default(cuid())
  name          String
  columns       Columns[]
  users         UserOnBoards[]
  labels        Labels[]
  integrations  BoardIntegration[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([id])
}

model Integrations {
  id                  String              @id @default(cuid())
  userId              String             
  provider            IntegrationProvider

  accessToken         String
  refreshToken        String?
  tokenExpiresAt      DateTime?
  scopes              String[]

  providerAccountId   String
  providerAccountUrl  String?

  status              IntegrationStatus @default(active)
  user                Users              @relation(fields: [userId], references: [id], onDelete: Cascade)
  boards              BoardIntegration[]

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([userId, provider, providerAccountId])
}

model BoardIntegration {
  id              String      @id @default(cuid())
  boardId         String
  integrationId   String
  
  // identificação do projeto/repo externo
  externalProjectId   String  // ex: issue number no GitHub, project key no Jira
  externalProjectName String  // nome legível pro usuário ver na UI
  
  lastSyncAt      DateTime?
  board           Boards       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  integration     Integrations @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([boardId, integrationId, externalProjectId])
}

model UserOnBoards {
  userId      String
  boardId     String
  user        Users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  board       Boards     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  role        BoardRole @default(member)
  assignedAt  DateTime  @default(now())

  @@id([userId, boardId])
  @@index([userId, boardId])
}

model Cards {
  id              String   @id @default(cuid())
  title           String
  description     String?
  order           Int
  labels          CardLabels[]
  comments        Comments[]
  attachments     Attachments[]
  columnId        String
  column          Columns   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  sourceProvider  IntegrationProvider?
  sourceId        String?
  sourceUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([id, columnId])
}

model Labels {
  id      String  @id @default(cuid())
  name    String
  color   String
  boardId String
  board   Boards   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards   CardLabels[]
  @@index([id, boardId])
}

model CardLabels {
  cardId  String
  labelId String
  card    Cards    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label   Labels   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
}

model Comments {
  id        String    @id @default(cuid())
  content   String
  cardId    String
  userId    String
  card      Cards      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      Users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@index([id, cardId, userId])
}

model Attachments {
  id        String    @id @default(cuid())
  filename  String
  url       String 
  size      Int
  cardId    String
  card      Cards      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  @@index([id, cardId])
}

